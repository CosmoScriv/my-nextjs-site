{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Next.js app",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "nextjs",
          "pattern": "^.*$",
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*ready - started server.*",
            "endsPattern": ".*Local:.*"
          }
        }
      ]
    }
  ]
}
